        // Рендеринг всех сообщений чата
        function renderCurrentChatMessages() {
            const activeChat = chats.find(c => c.id === currentChatId);
            const messagesContainer = document.getElementById('chat-bubbles-list');
            
            if (!activeChat) {
                document.getElementById('current-chat-title').textContent = "Fred Assistant";
