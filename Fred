    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInWithCustomToken, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, getDoc, collection, query, onSnapshot, addDoc, updateDoc, deleteDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Глобальная инициализация Firebase из переданных сервером переменных
        const firebaseConfig = JSON.parse(__firebase_config);
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'fred-ai-assistant';

        // Системное состояние приложения
        let user = null;
        let chats = [];
        let currentChatId = null;
        let currentRenameId = null;

        // Системный промпт для сохранения идентичности "Fred"
        const SYSTEM_PROMPT = `You are Fred, a exceptionally intelligent, concise, and highly effective AI assistant. 
Your tone is warm, professional, engaging, and crisp. 
Under no circumstances should you mention "LLaMA", "Meta", "Groq", or any other platforms unless explicitly asked to explain technical API aspects. 
If asked who you are, simply state you are Fred, an AI designed to assist with tasks. 
Always output response utilizing neat Markdown formatting where appropriate (especially code snippets, bullet points, and headers).`;

        // ---------------- AUTHENTICATION & INITIALIZATION ----------------
        const initAuth = async () => {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
            } catch (error) {
                console.error("Auth initialization failed:", error);
                showToast("Authentication Failed! Some features might be restricted.", "error");
            }
        };

        initAuth();

        onAuthStateChanged(auth, (firebaseUser) => {
            user = firebaseUser;
            if (user) {
                document.getElementById('user-display-id').textContent = `ID: ${user.uid.substring(0, 8)}...`;
                // Начинаем слушать чаты из Firestore после авторизации
                setupChatsSubscription();
            } else {
                document.getElementById('user-display-id').textContent = "Offline / Error";
            }
        });

        // ---------------- СИНХРОНИЗАЦИЯ ЧАТОВ С FIREBASE (RULE 1, 2, 3) ----------------
        function setupChatsSubscription() {
            if (!user) return;

            // Путь к приватным данным пользователя (Правило 1)
            const chatsCollectionRef = collection(db, 'artifacts', appId, 'users', user.uid, 'chats');
            
            // В реальном времени отслеживаем изменения без сложных запросов (Правило 2)
            onSnapshot(chatsCollectionRef, (querySnapshot) => {
                chats = [];
                querySnapshot.forEach((doc) => {
                    const data = doc.data();
                    chats.push({
                        id: doc.id,
                        title: data.title || "Untitled Chat",
                        messages: data.messages || [],
                        updatedAt: data.updatedAt || Date.now()
                    });
                });

                // Сортировка данных в памяти браузера, чтобы обойти создание композитных индексов (Правило 2)
                chats.sort((a, b) => b.updatedAt - a.updatedAt);

                renderChatsList();
                
                // Устанавливаем первый чат как активный при первой загрузке
                if (chats.length > 0 && !currentChatId) {
                    selectChat(chats[0].id);
                } else if (currentChatId) {
                    renderCurrentChatMessages();
                }
            }, (error) => {
                console.error("Firestore Listener error:", error);
                showToast("Failed to fetch chats from database.", "error");
            });
        }

        // Создание нового чата
        window.createNewChat = async function() {
            if (!user) return;
            try {
                const chatsCollectionRef = collection(db, 'artifacts', appId, 'users', user.uid, 'chats');
                const newDocRef = await addDoc(chatsCollectionRef, {
                    title: "New Chat Session",
                    messages: [],
                    updatedAt: Date.now(),
                    createdAt: Date.now()
                });
                currentChatId = newDocRef.id;
                showToast("New chat session started!", "success");
            } catch (err) {
                console.error("Error creating chat:", err);
                showToast("Error starting a new chat.", "error");
            }
        }

        // Удаление чата
        window.deleteChat = async function(e, chatId) {
            e.stopPropagation(); // Исключаем клик по строке чата
            if (!user) return;
            try {
                const docRef = doc(db, 'artifacts', appId, 'users', user.uid, 'chats', chatId);
                await deleteDoc(docRef);
                showToast("Chat deleted successfully.", "info");

                if (currentChatId === chatId) {
                    currentChatId = null;
                    document.getElementById('chat-bubbles-list').innerHTML = '';
                    updateWelcomeStateVisibility();
                }
            } catch (err) {
                console.error("Error deleting chat:", err);
                showToast("Error deleting chat.", "error");
            }
        }

        // Обновление заголовка чата
        window.updateChatTitle = async function(chatId, newTitle) {
            if (!user) return;
            try {
                const docRef = doc(db, 'artifacts', appId, 'users', user.uid, 'chats', chatId);
                await updateDoc(docRef, {
                    title: newTitle,
