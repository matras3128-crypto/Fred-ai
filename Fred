        // ---------------- ИНТЕГРАЦИЯ С GROQ API ----------------
        window.handleSendMessage = async function(e) {
            e.preventDefault();
            const inputEl = document.getElementById('user-input');
            const prompt = inputEl.value.trim();
            if (!prompt) return;

            // Проверка ключа
            const apiKey = getApiKey();
            if (!apiKey) {
                showToast("Please save your Groq API Key first!", "error");
                document.getElementById('api-key-input').focus();
                return;
            }

            if (!currentChatId) {
                await createNewChat();
            }

            const activeChat = chats.find(c => c.id === currentChatId);
            if (!activeChat) return;

            inputEl.value = '';
            inputEl.style.height = 'auto';
            setLoadingUI(true);

            // Создаем массив сообщений локально с учетом контекстной памяти
            const userMsg = { role: 'user', content: prompt, timestamp: Date.now() };
            const updatedMessages = [...(activeChat.messages || []), userMsg];

            // Рендерим промежуточное сообщение пользователя для мгновенного отклика
            renderTemporaryUserMessage(prompt);

            try {
                let newTitle = activeChat.title;
                if (activeChat.messages.length === 0) {
                    newTitle = prompt.length > 25 ? prompt.substring(0, 25) + '...' : prompt;
                }

                // Запрос к LLaMA 3.3 70B на Groq
                const assistantReplyText = await sendChatToGroq(updatedMessages, apiKey);
                const assistantMsg = { role: 'assistant', content: assistantReplyText, timestamp: Date.now() };
                
                // Сохранение переписки и контекста в Firestore
                const docRef = doc(db, 'artifacts', appId, 'users', user.uid, 'chats', currentChatId);
                await updateDoc(docRef, {
                    title: newTitle,
                    messages: [...updatedMessages, assistantMsg],
                    updatedAt: Date.now()
                });

            } catch (err) {
                console.error("API Call error:", err);
                showToast(err.message || "Failed to contact Fred API", "error");
                renderTemporaryErrorMessage(err.message || "Service currently unavailable.");
            } finally {
                setLoadingUI(false);
            }
        }

        // Запрос к API с экспоненциальной задержкой в случае перегрузки
        async function sendChatToGroq(messagesHistory, apiKey) {
            const formattedMessagesForAPI = [
                { role: 'system', content: SYSTEM_PROMPT },
                ...messagesHistory.map(m => ({ role: m.role, content: m.content }))
            ];

            const endpoint = "https://api.groq.com/openai/v1/chat/completions";
            const payload = {
                model: "llama-3.3-70b-versatile",
                messages: formattedMessagesForAPI,
                temperature: 0.7,
                max_tokens: 2048,
                top_p: 1
            };

            const maxRetries = 4;
            let currentDelay = 1000;

            for (let i = 0; i <= maxRetries; i++) {
                try {
                    const response = await fetch(endpoint, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${apiKey}`
                        },
                        body: JSON.stringify(payload)
                    });

                    if (!response.ok) {
                        const errorBody = await response.json().catch(() => ({}));
                        const errMsg = errorBody.error?.message || `HTTP Status ${response.status}`;
                        throw new Error(errMsg);
                    }

                    const data = await response.json();
                    return data.choices?.[0]?.message?.content || "No response received.";

                } catch (error) {
                    if (i === maxRetries) {
                        throw error;
                    }
                    await new Promise(res => setTimeout(res, currentDelay));
                    currentDelay *= 2;
                }
            }
        }

        // Временные сообщения на экране
        function renderTemporaryUserMessage(prompt) {
